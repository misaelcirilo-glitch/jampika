{
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "npx prisma generate && npx tsc"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.mjs"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/reminders/run",
      "schedule": "*/30 * * * *"
    }
  ]
}
